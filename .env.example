# ==========================================
# Song Detector Environment Configuration
# ==========================================

# 1. Commercial Recognition Fallback (Choose AudD or ACRCloud)
# AudD API (https://audd.io/)
AUDD_API_TOKEN=your_audd_api_token_here

# ACRCloud Project Credentials (https://console.acrcloud.com/)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key_here
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret_here

# 2. Database & State Store Endpoints
# If PostgreSQL is not reachable, the system automatically uses local SQLite (song_detector.sqlite3)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/song_detector

# If Redis is not reachable, the system automatically runs an in-memory nonce cache
REDIS_URL=redis://127.0.0.1:6379/0
